{
  "name": "Distributed Inference Blueprint",
  "description": "HTTP inference through a distributed vLLM engine with on-chain layer allocation and proportional revenue accounting.",
  "author": "Tangle Network",
  "category": "AI Inference",
  "image": null,
  "website": "https://tangle.tools",
  "codeRepository": "https://github.com/tangle-network/distributed-inference-blueprint",
  "docs": "https://github.com/tangle-network/distributed-inference-blueprint#readme",
  "integrity": null,
  "blueprintUi": {
    "displayName": "Distributed Inference",
    "description": "Inspect engine health, operator layer allocations, and on-chain revenue accounting.",
    "requestedSlug": "distributed-inference",
    "publisher": {
      "name": "Tangle Network",
      "namespace": "tangle",
      "verified": false
    },
    "resources": {
      "serviceLabel": "Pipeline",
      "itemLabel": "Stage",
      "itemRoute": "agents"
    },
    "surfaces": [
      "generic-overview",
      "service-explorer",
      "actions-panel",
      "resources",
      "metrics",
      "permissions"
    ],
    "theme": {
      "badgeLabel": "Multi-operator pipeline",
      "accentColor": "#0891B2",
      "secondaryColor": "#083344",
      "icon": "graph"
    },
    "overviewCards": [],
    "actions": [
      {
        "id": "create-inference-pipeline",
        "label": "Create pipeline",
        "description": "Initialize a new multi-stage inference pipeline for a model, specifying total layers and minimum operator count. Registers the pipeline on-chain for layer assignment.",
        "target": "service",
        "submitLabel": "Create",
        "fields": [
          {
            "key": "model_id",
            "label": "Model ID",
            "input": "text",
            "required": true,
            "placeholder": "meta-llama/Llama-3.1-405B-Instruct"
          },
          {
            "key": "total_layers",
            "label": "Total layers",
            "input": "number",
            "required": true,
            "placeholder": "126"
          },
          {
            "key": "min_operators",
            "label": "Minimum operators",
            "input": "number",
            "required": true,
            "placeholder": "4"
          }
        ]
      },
      {
        "id": "join-pipeline-stage",
        "label": "Join as stage",
        "description": "Register a contiguous layer range for a model and GPU requirement.",
        "target": "resource",
        "submitLabel": "Join",
        "fields": [
          {
            "key": "pipeline_id",
            "label": "Pipeline ID",
            "input": "text",
            "required": true,
            "placeholder": "pipeline_xyz"
          },
          {
            "key": "layer_range",
            "label": "Layer assignment mode",
            "input": "select",
            "required": true,
            "options": [
              {
                "label": "Manual start/end",
                "value": "manual"
              },
              {
                "label": "Auto-assign next range",
                "value": "auto"
              }
            ]
          },
          {
            "key": "layer_start",
            "label": "Layer start (manual mode)",
            "input": "number",
            "required": false,
            "placeholder": "32"
          }
        ]
      }
    ],
    "resourceViews": [
      {
        "id": "pipeline-stages",
        "title": "Pipeline stages",
        "kind": "table",
        "target": "resource",
        "defaultSort": "layer_start:asc",
        "columns": [
          {
            "key": "stage",
            "label": "Stage",
            "emphasis": true
          },
          {
            "key": "operator",
            "label": "Operator"
          },
          {
            "key": "layers",
            "label": "Layers"
          },
          {
            "key": "peer_state",
            "label": "Peer state"
          },
          {
            "key": "latency",
            "label": "Latency"
          }
        ]
      }
    ],
    "modules": []
  }
}
